# IR-Copilot configuration. Copy to `.env` and edit. `.env` is git-ignored.
#   cp .env.example .env

# ---- Demo target ----
DEMO_TICKER=NVDA
DEMO_PERIOD=FY2026Q2
# true  = deterministic mock financials (offline, reproducible demo)
# false = live defeatbeta-api with yfinance fallback
USE_MOCK_DATA=true

# ---- Paths (generated artifacts; git-ignored) ----
DATA_DIR=data
ARTIFACTS_DIR=artifacts

# ---- vLLM on AMD MI300X (OpenAI-compatible endpoints) ----
OPENAI_API_KEY=EMPTY
DRAFTING_BASE_URL=http://mi300x-node:8000/v1
DRAFTING_MODEL=meta-llama/Llama-3.1-70B-Instruct
ANALYST_BASE_URL=http://mi300x-node:8001/v1
ANALYST_MODEL=qpredict
VERIFIER_BASE_URL=http://mi300x-node:8003/v1
VERIFIER_MODEL=meta-llama/Llama-3.1-8B-Instruct
EMBEDDING_BASE_URL=http://mi300x-node:8002/v1
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# ---- Vector store (Qdrant) ----
# QDRANT_MODE: memory (in-process, zero setup) | docker (remote at QDRANT_URL) | local (on-disk)
QDRANT_MODE=memory
QDRANT_URL=http://localhost:6333
QDRANT_PATH=artifacts/qdrant
QDRANT_COLLECTION=ir_wiki

# ---- Embeddings backend ----
# hash (offline, no downloads) | sentence-transformers (real, local) | vllm (remote endpoint)
EMBEDDING_BACKEND=hash
EMBEDDING_DIM=384

# ---- Sentiment backend ----
# lexicon (offline) | finbert (ProsusAI/finbert via transformers, local)
SENTIMENT_BACKEND=finbert

# ---- LLM backend for agents ----
# mock (offline, deterministic) | vllm (OpenAI-compatible endpoints above)
LLM_BACKEND=mock

# ---- Competitor comparison ----
PEER_TICKERS=AMD,TSLA
